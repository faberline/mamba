{
  "dummy_variables_rgx": "_+$|(_[a-zA-Z0-9_]*[a-zA-Z0-9]+?$)|dummy|^ignored_|^unused_",
  "ignored_argument_names": "_.*|^ignored_|^unused_",
  "allowed_redefined_builtins": [],
  "redefining_builtins_modules": [
    "six.moves",
    "past.builtins",
    "future.builtins",
    "builtins",
    "io"
  ],
  "allow_global_unused_variables": true,
  "ignore_on_opaque_inference": true,
  "allow_wildcard_with_all": false,
  "callbacks": [
    "cb_",
    "_cb"
  ],
  "good_names": [
    "i",
    "j",
    "k",
    "ex",
    "Run",
    "_"
  ],
  "bad_names": [
    "foo",
    "bar",
    "baz",
    "toto",
    "tutu",
    "tata"
  ],
  "min_public_methods": 2,
  "max_public_methods": 20,
  "valid_classmethod_first_arg": [
    "cls"
  ],
  "valid_metaclass_classmethod_first_arg": [
    "mcs"
  ],
  "max_parents": 7,
  "max_attributes": 7,
  "ignored_parents": [],
  "exclude_too_few_public_methods": [],
  "defining_attr_methods": [
    "__init__",
    "__new__",
    "setUp",
    "asyncSetUp",
    "__post_init__"
  ],
  "mixin_class_rgx": ".*[Mm]ixin",
  "ignored_checks_for_mixins": [
    "no-member",
    "not-async-context-manager",
    "not-context-manager",
    "attribute-defined-outside-init"
  ],
  "exclude_protected": [
    "_asdict",
    "_fields",
    "_replace",
    "_source",
    "_make",
    "os._exit"
  ],
  "check_protected_access_in_special_methods": false,
  "max_args": 5,
  "max_positional_arguments": 5,
  "max_locals": 15,
  "max_returns": 6,
  "max_branches": 12,
  "max_statements": 50,
  "max_bool_expr": 5,
  "contextmanager_decorators": [
    "contextlib.contextmanager"
  ],
  "max_module_lines": 1000,
  "indent_string": "    ",
  "expected_line_ending_format": "",
  "notes": [
    "FIXME",
    "XXX",
    "TODO"
  ],
  "notes_rgx": "",
  "check_fixme_in_docstring": false,
