      "name": "generic-forwarding",
      "filename": "candidate.py",
      "source": "from __future__ import annotations\n\nfrom typing import Callable, Concatenate, ParamSpec, TypeVar, TypeVarTuple, Unpack\n\nP = ParamSpec(\"P\")\nT = TypeVar(\"T\")\nTs = TypeVarTuple(\"Ts\")\n\ndef relay(callback: Callable[P, T]) -> Callable[P, T]:\n    def wrapper(*args: P.args, **kwargs: P.kwargs) -> T:\n        return callback(*args, **kwargs)\n    return wrapper\n\ndef prepend(callback: Callable[Concatenate[int, P], T]) -> Callable[P, T]:\n    def wrapper(*args: P.args, **kwargs: P.kwargs) -> T:\n        return callback(1, *args, **kwargs)\n    return wrapper\n\ndef pack(*values: Unpack[Ts]) -> tuple[Unpack[Ts]]:\n    return values\n\ndef outer[T](callback: \"Callable[[T], T]\", value: T) -> T:\n    def inner(item: T) -> T:\n        return callback(item)\n    return inner(value)\n\nclass Holder[T]:\n    def __init__(self, value: T) -> None:\n        self.value: T = value\n\n    def map(self, callback: \"Callable[[T], T]\") -> T:\n        return callback(self.value)\n\ndef integer(value: int) -> int:\n    return value\n\nreveal_type(relay(integer)(1))\nreveal_type(pack(1, \"x\"))\nreveal_type(outer(integer, 1))\nreveal_type(Holder(1).map(integer))\n",
      "source_sha256": "72e0e9a936583c965e63cf9affbaaf27aea0eec336d3fd3dd4c9b28a55c61fe5",
