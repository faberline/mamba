# Typeshed checkout pinned by vendor/typeshed.lock.toml.
# Re-create with: python3.12 tests/harness/cpython/tools/checkout_typeshed.py
vendor/typeshed/

# Artifacts left in cwd by running CPython Lib/test oracle fixtures
# (os/pathlib tests create these); not part of the corpus.
/base/
/dirlinktest

/@mamba_test
/main.py
/t_main/
/mbtmp_named_*

# Tool run caches and state written under the cwd; process output, never source.
# Guard waivers (.guard/waivers.json) are source.
.aw/
.qc/
.meter/
.guard/*
!.guard/waivers.json
.vat/
.rig/
.arena/
.local/
.benchmarks/
.baselines/
.jet/
.vite/
.tdc/state.toml
mutants.out
mutants.out.old
# Per-run scratch left by dispatched agents; only agents/, skills/ and plugins/
# are source under .agents/.
.agents/*
!.agents/agents/
!.agents/skills/
!.agents/plugins/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
.mcp.json
.playwright-mcp/
# Python, Node and environment files.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
node_modules/
.env
.env.*
!.env.example
# Editors and OS.
.vscode/
.idea/
*.swp
.DS_Store

# Cargo build output.
/target/

# CPython conformance fixtures leak os_helper TESTFN artifacts into the cwd.
@test_*_tmp*
@mamba_test_*
# Derived conformance perf-baseline cache.
tests/cpython/.cache/
# Alternate target dirs used by dispatched dev agents.
.mamba-dev-target*/
